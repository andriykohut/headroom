  silhouette from the alpha channel alone, so this is deliberately two solid
  paths separated by a gap - the gap is the meter's threshold notch, and it is
  the only thing that has to survive.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path android:fillColor="#FFFFFF" android:pathData="M2.94 6.7A10.5 10.5 0 0 1 21.06 6.7Z"/>
    <path android:fillColor="#FFFFFF" android:pathData="M1.97 8.9A10.5 10.5 0 1 0 22.03 8.9Z"/>
</vector>
